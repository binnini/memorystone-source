   "updated": 1,
   "link": null,
   "locked": false,
   "text": "⑦ 지시를 실제로\n수행하는 것은\n컨트롤러 자신",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 13,
   "containerId": null,
   "originalText": "⑦ 지시를 실제로\n수행하는 것은\n컨트롤러 자신",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "core-0070",
   "type": "text",
   "x": 250.46,
   "y": 1130,
   "width": 379.08,
   "height": 67.5,
   "angle": 0,
   "strokeColor": "#e03131",
